# GitHub Collective Hub server (Railway). Copy to .env for local runs (`npm run dev`); .env is git-ignored.
# On Railway, set these under the service's Variables tab instead. Never commit real values.

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps). Sign-in only: no scopes are requested.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The only GitHub account allowed to sign in, by its numeric user id (stable across renames).
# Eddycollab = 64090020 (https://api.github.com/users/Eddycollab -> "id").
ALLOWED_GITHUB_ID=64090020

# Fine-grained token for the private library only (Contents: Read and write; Actions: Read-only optional).
LIBRARY_TOKEN=

# Random, at least 32 characters. Changing it signs every device out.
SESSION_SECRET=

# The public https origin of this service, e.g. https://collective-hub-production.up.railway.app
# (OAuth callback = PUBLIC_URL + /auth/callback). http is accepted only for localhost.
PUBLIC_URL=http://localhost:8080

# Optional. Railway sets PORT itself. The library is fixed to Eddycollab/github-library-collection-.
# PORT=8080
